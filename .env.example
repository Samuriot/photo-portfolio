# Copy to .env.local and edit.

# rustfs address (dev proxy target)
RUSTFS_URL=http://127.0.0.1:9002

# Bucket holding the gallery photos
VITE_PHOTO_BUCKET=photos

# Where the browser loads photos from. "/bucket" uses the dev proxy.
# Later: your public HTTPS URL, e.g. https://photos.yourdomain.com
VITE_PHOTO_BASE_URL=/bucket
